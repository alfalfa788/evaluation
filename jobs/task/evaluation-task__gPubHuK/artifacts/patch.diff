+"""Unit tests for animals and grass classes."""
+
+import sys
+import os
+import pytest
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
+
+from simulation.animals import Animal, Rabbit, Fox, Grass
+
+
+@pytest.fixture(autouse=True)
+def reset_animal_ids():
+    """Reset animal ID counter before each test for deterministic ID generation."""
+    Animal.reset_ids()
+
+
+def test_grass_initialization():
+    grass = Grass(position=(2, 3), energy_value=5.0)
+    assert grass.position == (2, 3)
+    assert grass.energy_value == 5.0
+
+
+def test_animals_lose_energy_correctly():
+    rabbit = Rabbit(position=(0, 0), energy=10.0, energy_loss_rate=1.5)
+    remaining = rabbit.lose_energy()
+    assert remaining == 8.5
+    assert rabbit.energy == 8.5
+    assert rabbit.is_alive()
+
+    # Test custom amount
+    rabbit.lose_energy(5.0)
+    assert rabbit.energy == 3.5
+
+    # Test dying from energy loss
+    rabbit.lose_energy(10.0)
+    assert rabbit.energy == 0.0
+    assert not rabbit.is_alive()
+
+
+def test_animals_age_correctly():
+    fox = Fox(position=(1, 1), age=38, max_age=40)
+    assert fox.is_alive()
+    
+    age = fox.age_one_step()
+    assert age == 39
+    assert fox.is_alive()
+
+    age = fox.age_one_step()
+    assert age == 40
+    assert not fox.is_alive()
+
+
+def test_dead_animals_status():
+    rabbit = Rabbit(position=(0, 0), energy=10.0, age=0, max_age=10)
+    assert rabbit.is_alive()
+    rabbit.die()
+    assert not rabbit.is_alive()
+    assert rabbit.energy == 0.0
+
+
+def test_rabbits_can_eat_grass():
+    rabbit = Rabbit(position=(0, 0), energy=10.0, energy_gain_from_grass=4.0)
+    grass = Grass(position=(0, 0), energy_value=4.0)
+    
+    rabbit.eat_grass(grass)
+    assert rabbit.energy == 14.0
+
+    # Dead rabbit cannot eat
+    rabbit.die()
+    rabbit.eat_grass(grass)
+    assert rabbit.energy == 0.0
+
+
+def test_foxes_can_hunt_rabbits():
+    fox = Fox(position=(3, 3), energy=15.0, energy_gain_from_rabbit=10.0)
+    rabbit = Rabbit(position=(3, 3), energy=12.0)
+    
+    assert rabbit.is_alive()
+    fox.hunt_rabbit(rabbit)
+    assert not rabbit.is_alive()
+    assert rabbit.energy == 0.0
+    assert fox.energy == 25.0
+
+    # Hunting already dead rabbit should not increase energy
+    fox.hunt_rabbit(rabbit)
+    assert fox.energy == 25.0
+
+
+def test_reproduction_creates_valid_new_animals():
+    rabbit = Rabbit(
+        position=(5, 5),
+        energy=25.0,
+        reproduction_threshold=20.0,
+        reproduction_cost=12.0,
+    )
+    assert rabbit.can_reproduce()
+    
+    offspring = rabbit.reproduce()
+    assert offspring is not None
+    assert isinstance(offspring, Rabbit)
+    assert offspring.position == (5, 5)
+    assert offspring.energy == 12.0
+    assert offspring.age == 0
+    assert offspring.is_alive()
+    assert rabbit.energy == 13.0  # 25 - 12
+    assert offspring.id != rabbit.id
+
+    # Cannot reproduce if energy below threshold
+    assert not rabbit.can_reproduce()
+    assert rabbit.reproduce() is None
+
+
+def test_animal_movement_within_bounds():
+    rabbit = Rabbit(position=(0, 0), energy=10.0)
+    for _ in range(20):
+        pos = rabbit.move(grid_width=5, grid_height=5)
+        x, y = pos
+        assert 0 <= x < 5
+        assert 0 <= y < 5
+        assert rabbit.position == pos
