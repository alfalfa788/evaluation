+"""Module defining the main Ecosystem simulation environment."""
+
+from __future__ import annotations
+import random
+from typing import Any
+from simulation.animals import Animal, Grass, Rabbit, Fox
+from simulation.statistics import StatisticsTracker
+
+
+class Ecosystem:
+    """Represents the two-dimensional ecosystem simulation grid and controls simulation stepping.
+
+    Attributes:
+        width: The grid width (number of columns).
+        height: The grid height (number of rows).
+        rabbits: List of currently living Rabbit instances.
+        foxes: List of currently living Fox instances.
+        grass: Dictionary mapping (x, y) coordinates to Grass instances.
+        stats: Tracker for recording population statistics.
+        current_step: Current simulation time step.
+        grass_growth_rate: Probability of grass growing in an empty cell during a step.
+    """
+
+    def __init__(
+        self,
+        width: int = 30,
+        height: int = 30,
+        initial_rabbits: int = 20,
+        initial_foxes: int = 5,
+        initial_grass: int | None = None,
+        grass_growth_rate: float = 0.1,
+        seed: int | None = None,
+    ) -> None:
+        """Initialize the ecosystem grid and populate initial animals and grass.
+
+        Args:
+            width: Grid width. Must be a positive integer.
+            height: Grid height. Must be a positive integer.
+            initial_rabbits: Starting count of rabbits. Must be non-negative.
+            initial_foxes: Starting count of foxes. Must be non-negative.
+            initial_grass: Starting count of grass patches. Defaults to 50% of grid capacity.
+            grass_growth_rate: Probability per step for grass to grow in empty cells.
+            seed: Optional random seed for reproducible simulations.
+
+        Raises:
+            ValueError: If grid dimensions or starting counts are invalid.
+        """
+        if width <= 0 or height <= 0:
+            raise ValueError("Grid width and height must be positive integers.")
+        if initial_rabbits < 0 or initial_foxes < 0:
+            raise ValueError("Initial population counts cannot be negative.")
+        if grass_growth_rate < 0.0 or grass_growth_rate > 1.0:
+            raise ValueError("Grass growth rate must be between 0.0 and 1.0.")
+
+        if seed is not None:
+            random.seed(seed)
+
+        self.width: int = width
+        self.height: int = height
+        self.grass_growth_rate: float = float(grass_growth_rate)
+        self.current_step: int = 0
+        self.stats: StatisticsTracker = StatisticsTracker()
+
+        self.rabbits: list[Rabbit] = []
+        self.foxes: list[Fox] = []
+        self.grass: dict[tuple[int, int], Grass] = {}
+
+        self._initialize_population(initial_rabbits, initial_foxes, initial_grass)
+        self._record_current_stats()
+
+    def _initialize_population(
+        self,
+        initial_rabbits: int,
+        initial_foxes: int,
+        initial_grass: int | None,
+    ) -> None:
+        """Populate the grid with initial grass and animals."""
+        total_cells = self.width * self.height
+        if initial_grass is None:
+            grass_count = int(total_cells * 0.5)
+        else:
+            if initial_grass < 0:
+                raise ValueError("Initial grass count cannot be negative.")
+            grass_count = min(initial_grass, total_cells)
+
+        all_coords = [(x, y) for x in range(self.width) for y in range(self.height)]
+        chosen_grass_coords = random.sample(all_coords, grass_count)
+        for coord in chosen_grass_coords:
+            self.grass[coord] = Grass(position=coord)
+
+        for _ in range(initial_rabbits):
+            pos = (random.randint(0, self.width - 1), random.randint(0, self.height - 1))
+            self.rabbits.append(Rabbit(position=pos))
+
+        for _ in range(initial_foxes):
+            pos = (random.randint(0, self.width - 1), random.randint(0, self.height - 1))
+            self.foxes.append(Fox(position=pos))
+
+    def _record_current_stats(self) -> None:
+        """Record current living animal and grass counts in the statistics tracker."""
+        self.stats.record_step(
+            step=self.current_step,
+            rabbits=len(self.rabbits),
+            foxes=len(self.foxes),
+            grass=len(self.grass),
+        )
+
+    def _grow_grass(self) -> None:
+        """Grow grass in empty grid cells according to the grass growth rate."""
+        for x in range(self.width):
+            for y in range(self.height):
+                coord = (x, y)
+                if coord not in self.grass:
+                    if random.random() < self.grass_growth_rate:
+                        self.grass[coord] = Grass(position=coord)
+
+    def _step_rabbits(self) -> list[Rabbit]:
+        """Execute one step for all living rabbits (move, eat, lose energy, age, reproduce).
+
+        Returns:
+            A list of newly born Rabbit offspring.
+        """
+        self.rabbits.sort(key=lambda r: r.id)
+        new_offspring: list[Rabbit] = []
+
+        for rabbit in list(self.rabbits):
+            if not rabbit.is_alive():
+                continue
+
+            rabbit.move(self.width, self.height)
+
+            nearby_cells = sorted(
+                Animal.get_neighbors(rabbit.position, self.width, self.height, include_self=True)
+            )
+            for cell in nearby_cells:
+                if cell in self.grass:
+                    grass_obj = self.grass.pop(cell)
+                    rabbit.eat_grass(grass_obj)
+                    break
+
+            rabbit.lose_energy()
+            rabbit.age_one_step()
+
+            if rabbit.is_alive() and rabbit.can_reproduce():
+                baby = rabbit.reproduce()
+                if baby is not None:
+                    new_offspring.append(baby)
+
+        return new_offspring
+
+    def _step_foxes(self) -> list[Fox]:
+        """Execute one step for all living foxes (move, hunt, lose energy, age, reproduce).
+
+        Returns:
+            A list of newly born Fox offspring.
+        """
+        self.foxes.sort(key=lambda f: f.id)
+        new_offspring: list[Fox] = []
+
+        for fox in list(self.foxes):
+            if not fox.is_alive():
+                continue
+
+            fox.move(self.width, self.height)
+
+            nearby_cells = set(
+                Animal.get_neighbors(fox.position, self.width, self.height, include_self=True)
+            )
+            living_rabbits = [
+                r for r in self.rabbits if r.is_alive() and r.position in nearby_cells
+            ]
+            living_rabbits.sort(key=lambda r: (r.position, r.id))
+
+            if living_rabbits:
+                target = living_rabbits[0]
+                fox.hunt_rabbit(target)
+
+            fox.lose_energy()
+            fox.age_one_step()
+
+            if fox.is_alive() and fox.can_reproduce():
+                baby = fox.reproduce()
+                if baby is not None:
+                    new_offspring.append(baby)
+
+        return new_offspring
+
+    def _cleanup_dead_animals(self) -> None:
+        """Remove dead animals from the ecosystem population lists."""
+        self.rabbits = [r for r in self.rabbits if r.is_alive()]
+        self.foxes = [f for f in self.foxes if f.is_alive()]
+
+    def step(self) -> None:
+        """Advance the ecosystem simulation by one discrete time step (one day)."""
+        self.current_step += 1
+
+        self._grow_grass()
+        new_rabbits = self._step_rabbits()
+        self.rabbits.extend(new_rabbits)
+        self._cleanup_dead_animals()
+
+        new_foxes = self._step_foxes()
+        self.foxes.extend(new_foxes)
+        self._cleanup_dead_animals()
+
+        self._record_current_stats()
+
+    def run(self, steps: int) -> None:
+        """Run the simulation for a specified number of time steps.
+
+        Args:
+            steps: Number of simulation steps to execute. Must be non-negative.
+
+        Raises:
+            ValueError: If steps is negative.
+        """
+        if steps < 0:
+            raise ValueError("Number of simulation steps cannot be negative.")
+        for _ in range(steps):
+            self.step()
+
+    def get_summary(self) -> dict[str, Any]:
+        """Get a summary dictionary of simulation statistics.
+
+        Returns:
+            Summary dictionary from the statistics tracker.
+        """
+        return self.stats.get_summary()
+
+    def format_summary(self) -> str:
+        """Get a formatted human-readable summary string of simulation statistics.
+
+        Returns:
+            Formatted summary string.
+        """
+        return self.stats.format_summary()
