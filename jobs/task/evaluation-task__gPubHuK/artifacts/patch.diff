+"""Module for recording, summarizing, and exporting ecosystem population statistics."""
+
+from __future__ import annotations
+import csv
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+
+@dataclass
+class PopulationStats:
+    """Represents the population counts at a single simulation time step.
+
+    Attributes:
+        step: The simulation step number (day).
+        rabbits: The count of living rabbits.
+        foxes: The count of living foxes.
+        grass: The count of grass patches.
+    """
+
+    step: int
+    rabbits: int
+    foxes: int
+    grass: int
+
+
+class StatisticsTracker:
+    """Tracks ecosystem population statistics over time and provides summaries and CSV export."""
+
+    def __init__(self) -> None:
+        """Initialize a new StatisticsTracker instance."""
+        self.history: list[PopulationStats] = []
+
+    def record_step(self, step: int, rabbits: int, foxes: int, grass: int) -> None:
+        """Record the population statistics for a specific simulation step.
+
+        Args:
+            step: The current step number.
+            rabbits: Number of living rabbits.
+            foxes: Number of living foxes.
+            grass: Number of grass patches.
+        """
+        self.history.append(
+            PopulationStats(
+                step=step,
+                rabbits=rabbits,
+                foxes=foxes,
+                grass=grass,
+            )
+        )
+
+    def save_to_csv(self, filepath: str | Path) -> None:
+        """Save the recorded statistics history to a CSV file.
+
+        Args:
+            filepath: Destination path for the CSV file.
+        """
+        path = Path(filepath)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with open(path, mode="w", newline="", encoding="utf-8") as csvfile:
+            writer = csv.writer(csvfile)
+            writer.writerow(["step", "rabbits", "foxes", "grass"])
+            for stats in self.history:
+                writer.writerow([stats.step, stats.rabbits, stats.foxes, stats.grass])
+
+    def get_summary(self) -> dict[str, Any]:
+        """Calculate and return a summary of the simulation statistics.
+
+        Returns:
+            A dictionary containing total steps, final counts, and min/max population sizes.
+        """
+        if not self.history:
+            return {
+                "total_steps": 0,
+                "final_rabbits": 0,
+                "final_foxes": 0,
+                "final_grass": 0,
+                "max_rabbits": 0,
+                "min_rabbits": 0,
+                "max_foxes": 0,
+                "min_foxes": 0,
+                "max_grass": 0,
+                "min_grass": 0,
+            }
+
+        final = self.history[-1]
+        rabbits_series = [s.rabbits for s in self.history]
+        foxes_series = [s.foxes for s in self.history]
+        grass_series = [s.grass for s in self.history]
+
+        return {
+            "total_steps": final.step,
+            "final_rabbits": final.rabbits,
+            "final_foxes": final.foxes,
+            "final_grass": final.grass,
+            "max_rabbits": max(rabbits_series),
+            "min_rabbits": min(rabbits_series),
+            "max_foxes": max(foxes_series),
+            "min_foxes": min(foxes_series),
+            "max_grass": max(grass_series),
+            "min_grass": min(grass_series),
+        }
+
+    def format_summary(self) -> str:
+        """Format the simulation summary into a human-readable string.
+
+        Returns:
+            A formatted multi-line summary string.
+        """
+        summary = self.get_summary()
+        lines = [
+            "=== Simulation Summary ===",
+            f"Total Simulation Steps: {summary['total_steps']}",
+            "Final Population:",
+            f"  - Rabbits: {summary['final_rabbits']}",
+            f"  - Foxes:   {summary['final_foxes']}",
+            f"  - Grass:   {summary['final_grass']}",
+            "Population Extremes:",
+            f"  - Rabbits: Min = {summary['min_rabbits']}, Max = {summary['max_rabbits']}",
+            f"  - Foxes:   Min = {summary['min_foxes']}, Max = {summary['max_foxes']}",
+            f"  - Grass:   Min = {summary['min_grass']}, Max = {summary['max_grass']}",
+            "==========================",
+        ]
+        return "\n".join(lines)
