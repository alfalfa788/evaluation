+"""Unit tests for statistics tracking, CSV output, and CLI argument validation."""
+
+import sys
+import os
+import csv
+import tempfile
+from pathlib import Path
+import pytest
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
+
+from simulation.statistics import StatisticsTracker, PopulationStats
+from simulation.cli import parse_args, main
+
+
+def test_statistics_tracker_recording():
+    tracker = StatisticsTracker()
+    tracker.record_step(0, 10, 5, 100)
+    tracker.record_step(1, 12, 5, 95)
+    
+    assert len(tracker.history) == 2
+    assert tracker.history[0] == PopulationStats(0, 10, 5, 100)
+    assert tracker.history[1] == PopulationStats(1, 12, 5, 95)
+
+
+def test_statistics_summary_calculations():
+    tracker = StatisticsTracker()
+    tracker.record_step(0, 20, 5, 100)
+    tracker.record_step(1, 30, 8, 80)
+    tracker.record_step(2, 15, 4, 120)
+    
+    summary = tracker.get_summary()
+    assert summary["total_steps"] == 2
+    assert summary["final_rabbits"] == 15
+    assert summary["final_foxes"] == 4
+    assert summary["final_grass"] == 120
+    assert summary["max_rabbits"] == 30
+    assert summary["min_rabbits"] == 15
+    assert summary["max_foxes"] == 8
+    assert summary["min_foxes"] == 4
+    assert summary["max_grass"] == 120
+    assert summary["min_grass"] == 80
+
+
+def test_empty_statistics_summary():
+    tracker = StatisticsTracker()
+    summary = tracker.get_summary()
+    assert summary["total_steps"] == 0
+    assert summary["final_rabbits"] == 0
+
+
+def test_statistics_written_correctly_to_csv():
+    tracker = StatisticsTracker()
+    tracker.record_step(0, 20, 5, 100)
+    tracker.record_step(1, 22, 6, 95)
+    
+    with tempfile.TemporaryDirectory() as tmpdir:
+        csv_path = Path(tmpdir) / "stats.csv"
+        tracker.save_to_csv(csv_path)
+        
+        assert csv_path.exists()
+        with open(csv_path, mode="r", encoding="utf-8") as f:
+            reader = list(csv.reader(f))
+            assert len(reader) == 3
+            assert reader[0] == ["step", "rabbits", "foxes", "grass"]
+            assert reader[1] == ["0", "20", "5", "100"]
+            assert reader[2] == ["1", "22", "6", "95"]
+
+
+def test_valid_cli_argument_parsing():
+    args = parse_args([
+        "--width", "40",
+        "--height", "50",
+        "--rabbits", "15",
+        "--foxes", "3",
+        "--steps", "10",
+        "--seed", "999",
+        "--output", "out.csv"
+    ])
+    assert args.width == 40
+    assert args.height == 50
+    assert args.rabbits == 15
+    assert args.foxes == 3
+    assert args.steps == 10
+    assert args.seed == 999
+    assert args.output == "out.csv"
+
+
+def test_invalid_cli_arguments():
+    with pytest.raises(SystemExit):
+        parse_args(["--width", "-10"])
+    with pytest.raises(SystemExit):
+        parse_args(["--height", "0"])
+    with pytest.raises(SystemExit):
+        parse_args(["--rabbits", "-5"])
+    with pytest.raises(SystemExit):
+        parse_args(["--foxes", "-1"])
+    with pytest.raises(SystemExit):
+        parse_args(["--steps", "-50"])
+    with pytest.raises(SystemExit):
+        parse_args(["--width", "abc"])
+
+
+def test_cli_main_execution():
+    with tempfile.TemporaryDirectory() as tmpdir:
+        out_file = Path(tmpdir) / "cli_test.csv"
+        ret = main(["--steps", "5", "--seed", "42", "--output", str(out_file)])
+        assert ret == 0
+        assert out_file.exists()
+
+
+def test_cli_main_invalid_execution():
+    ret = main(["--width", "-5"])
+    assert ret != 0
