+"""Unit tests for the Ecosystem simulation class."""
+
+import sys
+import os
+import pytest
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
+
+from simulation.ecosystem import Ecosystem
+from simulation.animals import Animal, Rabbit, Fox, Grass
+
+
+@pytest.fixture(autouse=True)
+def reset_animal_ids():
+    """Reset animal ID counter before each test for deterministic ID generation."""
+    Animal.reset_ids()
+
+
+def test_ecosystem_invalid_initialization():
+    with pytest.raises(ValueError):
+        Ecosystem(width=0, height=10)
+    with pytest.raises(ValueError):
+        Ecosystem(width=10, height=-5)
+    with pytest.raises(ValueError):
+        Ecosystem(initial_rabbits=-1)
+    with pytest.raises(ValueError):
+        Ecosystem(initial_foxes=-5)
+    with pytest.raises(ValueError):
+        Ecosystem(grass_growth_rate=1.5)
+    with pytest.raises(ValueError):
+        Ecosystem(initial_grass=-10)
+
+
+def test_dead_animals_are_removed():
+    eco = Ecosystem(width=10, height=10, initial_rabbits=1, initial_foxes=1, grass_growth_rate=0.0)
+    rabbit = eco.rabbits[0]
+    fox = eco.foxes[0]
+    
+    # Force animals to die
+    rabbit.die()
+    fox.die()
+    
+    eco.step()
+    assert len(eco.rabbits) == 0
+    assert len(eco.foxes) == 0
+
+
+def test_rabbits_eat_grass_in_ecosystem():
+    eco = Ecosystem(width=5, height=5, initial_rabbits=0, initial_foxes=0, initial_grass=0, grass_growth_rate=0.0)
+    rabbit = Rabbit(position=(2, 2), energy=10.0)
+    eco.rabbits.append(rabbit)
+    eco.grass[(2, 2)] = Grass(position=(2, 2), energy_value=5.0)
+    
+    for dx in [-1, 0, 1]:
+        for dy in [-1, 0, 1]:
+            eco.grass[(2 + dx, 2 + dy)] = Grass(position=(2 + dx, 2 + dy), energy_value=5.0)
+            
+    eco.step()
+    assert rabbit.energy == 14.0
+
+
+def test_foxes_hunt_rabbits_in_ecosystem():
+    eco = Ecosystem(width=2, height=2, initial_rabbits=0, initial_foxes=0, initial_grass=0, grass_growth_rate=0.0)
+    fox = Fox(position=(0, 0), energy=15.0, energy_gain_from_rabbit=10.0)
+    rabbit = Rabbit(position=(0, 0), energy=10.0)
+    
+    eco.foxes.append(fox)
+    eco.rabbits.append(rabbit)
+    
+    eco.step()
+    assert len(eco.rabbits) == 0
+    assert fox.energy == 24.0
+
+
+def test_reproduction_in_ecosystem():
+    eco = Ecosystem(width=5, height=5, initial_rabbits=0, initial_foxes=0, initial_grass=0, grass_growth_rate=0.0)
+    rabbit = Rabbit(position=(2, 2), energy=25.0, reproduction_threshold=20.0, reproduction_cost=10.0)
+    eco.rabbits.append(rabbit)
+    
+    eco.step()
+    assert len(eco.rabbits) == 2
+
+
+def test_reproducible_results_with_seed():
+    eco1 = Ecosystem(width=20, height=20, initial_rabbits=15, initial_foxes=4, seed=12345)
+    eco1.run(20)
+    
+    eco2 = Ecosystem(width=20, height=20, initial_rabbits=15, initial_foxes=4, seed=12345)
+    eco2.run(20)
+    
+    assert len(eco1.rabbits) == len(eco2.rabbits)
+    assert len(eco1.foxes) == len(eco2.foxes)
+    assert len(eco1.grass) == len(eco2.grass)
+    assert eco1.stats.history == eco2.stats.history
