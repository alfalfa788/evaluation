+"""Module containing the base animal class, specific animal species, and grass for the ecosystem simulation."""
+
+from __future__ import annotations
+from abc import ABC, abstractmethod
+import random
+from typing import ClassVar
+
+
+class Grass:
+    """Represents a patch of grass in the ecosystem grid.
+
+    Attributes:
+        position: A tuple of (x, y) coordinates representing the location on the grid.
+        energy_value: The nutritional energy gained by an animal consuming this grass.
+    """
+
+    def __init__(self, position: tuple[int, int], energy_value: float = 3.0) -> None:
+        """Initialize a new Grass patch.
+
+        Args:
+            position: The (x, y) coordinates on the grid.
+            energy_value: The amount of energy provided when eaten.
+        """
+        self.position: tuple[int, int] = position
+        self.energy_value: float = energy_value
+
+
+class Animal(ABC):
+    """Abstract base class representing an animal in the ecosystem.
+
+    Attributes:
+        id: A unique integer identifier for the animal.
+        position: The (x, y) coordinates on the grid.
+        energy: The current energy level of the animal.
+        age: The current age of the animal in time steps (days).
+        max_age: The maximum age the animal can reach before dying of old age.
+        energy_loss_rate: The amount of energy lost per simulation step.
+        reproduction_threshold: The minimum energy required to reproduce.
+        reproduction_cost: The energy consumed during reproduction.
+        alive: A boolean flag indicating whether the animal is currently alive.
+    """
+
+    _id_counter: ClassVar[int] = 1
+
+    @classmethod
+    def get_next_id(cls) -> int:
+        """Generate and return the next unique animal ID.
+
+        Returns:
+            A unique integer ID.
+        """
+        current_id = cls._id_counter
+        cls._id_counter += 1
+        return current_id
+
+    @classmethod
+    def reset_ids(cls) -> None:
+        """Reset the ID counter to 1. Useful for deterministic testing."""
+        cls._id_counter = 1
+
+    def __init__(
+        self,
+        position: tuple[int, int],
+        energy: float,
+        age: int = 0,
+        animal_id: int | None = None,
+        max_age: int = 25,
+        energy_loss_rate: float = 1.0,
+        reproduction_threshold: float = 20.0,
+        reproduction_cost: float = 12.0,
+    ) -> None:
+        """Initialize a new Animal instance.
+
+        Args:
+            position: Initial (x, y) grid coordinates.
+            energy: Initial energy level.
+            age: Initial age in days (defaults to 0).
+            animal_id: Unique identifier (auto-generated if None).
+            max_age: Maximum age before death.
+            energy_loss_rate: Energy lost each simulation step.
+            reproduction_threshold: Energy needed to reproduce.
+            reproduction_cost: Energy cost to create offspring.
+        """
+        self.id: int = animal_id if animal_id is not None else self.get_next_id()
+        self.position: tuple[int, int] = position
+        self.energy: float = float(energy)
+        self.age: int = age
+        self.max_age: int = max_age
+        self.energy_loss_rate: float = float(energy_loss_rate)
+        self.reproduction_threshold: float = float(reproduction_threshold)
+        self.reproduction_cost: float = float(reproduction_cost)
+        self.alive: bool = True
+
+    @staticmethod
+    def get_neighbors(
+        position: tuple[int, int],
+        width: int,
+        height: int,
+        include_self: bool = False,
+    ) -> list[tuple[int, int]]:
+        """Get valid neighboring grid coordinates around a position.
+
+        Args:
+            position: The (x, y) center position.
+            width: The width of the grid.
+            height: The height of the grid.
+            include_self: Whether to include the center position itself in the results.
+
+        Returns:
+            A list of valid (x, y) coordinate tuples sorted in deterministic order.
+        """
+        x, y = position
+        neighbors: list[tuple[int, int]] = []
+        for dx in (-1, 0, 1):
+            for dy in (-1, 0, 1):
+                if not include_self and dx == 0 and dy == 0:
+                    continue
+                nx, ny = x + dx, y + dy
+                if 0 <= nx < width and 0 <= ny < height:
+                    neighbors.append((nx, ny))
+        return neighbors
+
+    def move(self, grid_width: int, grid_height: int) -> tuple[int, int]:
+        """Move the animal to a random valid adjacent cell on the grid.
+
+        Args:
+            grid_width: Width of the grid.
+            grid_height: Height of the grid.
+
+        Returns:
+            The new position tuple (x, y).
+        """
+        if not self.is_alive():
+            return self.position
+        neighbors = self.get_neighbors(self.position, grid_width, grid_height, include_self=False)
+        if neighbors:
+            self.position = random.choice(neighbors)
+        return self.position
+
+    def lose_energy(self, amount: float | None = None) -> float:
+        """Decrease the animal's energy level.
+
+        Args:
+            amount: The amount of energy to subtract (defaults to energy_loss_rate).
+
+        Returns:
+            The remaining energy level.
+        """
+        loss = self.energy_loss_rate if amount is None else float(amount)
+        self.energy -= loss
+        if self.energy <= 0.0:
+            self.die()
+        return self.energy
+
+    def age_one_step(self) -> int:
+        """Increment the animal's age by one simulation step (day).
+
+        Returns:
+            The updated age.
+        """
+        self.age += 1
+        if self.age >= self.max_age:
+            self.die()
+        return self.age
+
+    def is_alive(self) -> bool:
+        """Check if the animal is currently alive.
+
+        Returns:
+            True if alive and energy > 0 and age < max_age, False otherwise.
+        """
+        if self.energy <= 0.0 or self.age >= self.max_age:
+            self.alive = False
+        return self.alive
+
+    def die(self) -> None:
+        """Mark the animal as dead and set its energy to zero."""
+        self.alive = False
+        self.energy = 0.0
+
+    def can_reproduce(self) -> bool:
+        """Check if the animal has enough energy and is alive to reproduce.
+
+        Returns:
+            True if reproduction is possible, False otherwise.
+        """
+        return self.is_alive() and self.energy >= self.reproduction_threshold
+
+    @abstractmethod
+    def reproduce(self) -> Animal | None:
+        """Create a new offspring animal if reproduction criteria are met.
+
+        Returns:
+            A new Animal instance if successful, or None if reproduction criteria are not met.
+        """
+        pass
+
+
+class Rabbit(Animal):
+    """Represents a rabbit (herbivore) in the ecosystem."""
+
+    def __init__(
+        self,
+        position: tuple[int, int],
+        energy: float = 10.0,
+        age: int = 0,
+        animal_id: int | None = None,
+        max_age: int = 25,
+        energy_loss_rate: float = 1.0,
+        reproduction_threshold: float = 20.0,
+        reproduction_cost: float = 12.0,
+        energy_gain_from_grass: float = 3.0,
+    ) -> None:
+        """Initialize a new Rabbit instance."""
+        super().__init__(
+            position=position,
+            energy=energy,
+            age=age,
+            animal_id=animal_id,
+            max_age=max_age,
+            energy_loss_rate=energy_loss_rate,
+            reproduction_threshold=reproduction_threshold,
+            reproduction_cost=reproduction_cost,
+        )
+        self.energy_gain_from_grass: float = float(energy_gain_from_grass)
+
+    def eat_grass(self, grass: Grass) -> float:
+        """Consume a patch of grass and gain energy.
+
+        Args:
+            grass: The Grass instance being eaten.
+
+        Returns:
+            The updated energy level of the rabbit.
+        """
+        if not self.is_alive():
+            return self.energy
+        self.energy += grass.energy_value if hasattr(grass, "energy_value") else self.energy_gain_from_grass
+        return self.energy
+
+    def reproduce(self) -> Rabbit | None:
+        """Reproduce to create a new offspring Rabbit.
+
+        Returns:
+            A new Rabbit instance if threshold is met, else None.
+        """
+        if not self.can_reproduce():
+            return None
+        self.energy -= self.reproduction_cost
+        offspring_energy = self.reproduction_cost
+        return Rabbit(
+            position=self.position,
+            energy=offspring_energy,
+            age=0,
+            max_age=self.max_age,
+            energy_loss_rate=self.energy_loss_rate,
+            reproduction_threshold=self.reproduction_threshold,
+            reproduction_cost=self.reproduction_cost,
+            energy_gain_from_grass=self.energy_gain_from_grass,
+        )
+
+
+class Fox(Animal):
+    """Represents a fox (predator) in the ecosystem."""
+
+    def __init__(
+        self,
+        position: tuple[int, int],
+        energy: float = 15.0,
+        age: int = 0,
+        animal_id: int | None = None,
+        max_age: int = 40,
+        energy_loss_rate: float = 1.0,
+        reproduction_threshold: float = 30.0,
+        reproduction_cost: float = 15.0,
+        energy_gain_from_rabbit: float = 8.0,
+    ) -> None:
+        """Initialize a new Fox instance."""
+        super().__init__(
+            position=position,
+            energy=energy,
+            age=age,
+            animal_id=animal_id,
+            max_age=max_age,
+            energy_loss_rate=energy_loss_rate,
+            reproduction_threshold=reproduction_threshold,
+            reproduction_cost=reproduction_cost,
+        )
+        self.energy_gain_from_rabbit: float = float(energy_gain_from_rabbit)
+
+    def hunt_rabbit(self, rabbit: Rabbit) -> float:
+        """Hunt and consume a rabbit to gain energy.
+
+        Args:
+            rabbit: The Rabbit instance being hunted.
+
+        Returns:
+            The updated energy level of the fox.
+        """
+        if not self.is_alive() or not rabbit.is_alive():
+            return self.energy
+        rabbit.die()
+        self.energy += self.energy_gain_from_rabbit
+        return self.energy
+
+    def reproduce(self) -> Fox | None:
+        """Reproduce to create a new offspring Fox.
+
+        Returns:
+            A new Fox instance if threshold is met, else None.
+        """
+        if not self.can_reproduce():
+            return None
+        self.energy -= self.reproduction_cost
+        offspring_energy = self.reproduction_cost
+        return Fox(
+            position=self.position,
+            energy=offspring_energy,
+            age=0,
+            max_age=self.max_age,
+            energy_loss_rate=self.energy_loss_rate,
+            reproduction_threshold=self.reproduction_threshold,
+            reproduction_cost=self.reproduction_cost,
+            energy_gain_from_rabbit=self.energy_gain_from_rabbit,
+        )
