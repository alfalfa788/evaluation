+"""Command-line interface for running the ecosystem simulation."""
+
+from __future__ import annotations
+import argparse
+import sys
+from typing import Sequence
+from simulation.ecosystem import Ecosystem
+
+
+def positive_int(value: str) -> int:
+    """Validate and convert argument to a positive integer (> 0)."""
+    try:
+        ivalue = int(value)
+        if ivalue <= 0:
+            raise ValueError()
+        return ivalue
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"'{value}' is an invalid positive integer (> 0).")
+
+
+def non_negative_int(value: str) -> int:
+    """Validate and convert argument to a non-negative integer (>= 0)."""
+    try:
+        ivalue = int(value)
+        if ivalue < 0:
+            raise ValueError()
+        return ivalue
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"'{value}' is an invalid non-negative integer (>= 0).")
+
+
+def parse_args(args: Sequence[str] | None = None) -> argparse.Namespace:
+    """Parse command line arguments for the simulation CLI.
+
+    Args:
+        args: Sequence of argument strings. Defaults to sys.argv[1:].
+
+    Returns:
+        Parsed arguments Namespace.
+    """
+    parser = argparse.ArgumentParser(
+        description="Run a 2D ecosystem simulation of rabbits, foxes, and grass."
+    )
+    parser.add_argument(
+        "--width",
+        type=positive_int,
+        default=30,
+        help="Grid width (number of columns, positive integer).",
+    )
+    parser.add_argument(
+        "--height",
+        type=positive_int,
+        default=30,
+        help="Grid height (number of rows, positive integer).",
+    )
+    parser.add_argument(
+        "--rabbits",
+        type=non_negative_int,
+        default=20,
+        help="Initial count of rabbits (non-negative integer).",
+    )
+    parser.add_argument(
+        "--foxes",
+        type=non_negative_int,
+        default=5,
+        help="Initial count of foxes (non-negative integer).",
+    )
+    parser.add_argument(
+        "--steps",
+        type=non_negative_int,
+        default=100,
+        help="Number of simulation steps to run (non-negative integer).",
+    )
+    parser.add_argument(
+        "--seed",
+        type=int,
+        default=None,
+        help="Random seed for reproducible results (integer).",
+    )
+    parser.add_argument(
+        "--output",
+        type=str,
+        default=None,
+        help="File path to save the population statistics CSV.",
+    )
+    return parser.parse_args(args)
+
+
+def main(args: Sequence[str] | None = None) -> int:
+    """Main execution function for the CLI.
+
+    Args:
+        args: Optional sequence of command-line argument strings.
+
+    Returns:
+        Exit status code (0 for success, non-zero for failure).
+    """
+    try:
+        parsed_args = parse_args(args)
+    except SystemExit as e:
+        return int(e.code) if e.code is not None else 1
+
+    try:
+        eco = Ecosystem(
+            width=parsed_args.width,
+            height=parsed_args.height,
+            initial_rabbits=parsed_args.rabbits,
+            initial_foxes=parsed_args.foxes,
+            seed=parsed_args.seed,
+        )
+        eco.run(steps=parsed_args.steps)
+        if parsed_args.output:
+            eco.stats.save_to_csv(parsed_args.output)
+        print(eco.format_summary())
+        return 0
+    except Exception as e:
+        print(f"Error running simulation: {e}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
