+"""Tests for statistics recording, summarising and CSV output, plus the CLI."""
+
+import csv
+
+import pytest
+
+from simulation.cli import build_parser, main
+from simulation.statistics import Statistics
+
+
+def test_record_and_summary():
+    stats = Statistics()
+    stats.record(1, 10, 2, 30)
+    stats.record(2, 15, 3, 25)
+    stats.record(3, 8, 1, 40)
+    summary = stats.summary()
+    assert summary["steps"] == 3
+    assert summary["final_rabbits"] == 8
+    assert summary["final_foxes"] == 1
+    assert summary["final_grass"] == 40
+    assert summary["max_rabbits"] == 15
+    assert summary["min_rabbits"] == 8
+    assert summary["max_foxes"] == 3
+    assert summary["min_foxes"] == 1
+
+
+def test_empty_summary():
+    stats = Statistics()
+    summary = stats.summary()
+    assert summary["steps"] == 0
+    assert summary["final_rabbits"] == 0
+
+
+def test_save_csv(tmp_path):
+    stats = Statistics()
+    stats.record(1, 10, 2, 30)
+    stats.record(2, 12, 3, 28)
+    path = tmp_path / "stats.csv"
+    stats.save_csv(str(path))
+
+    with open(path, newline="") as handle:
+        rows = list(csv.DictReader(handle))
+
+    assert len(rows) == 2
+    assert rows[0]["step"] == "1"
+    assert rows[0]["rabbits"] == "10"
+    assert rows[1]["foxes"] == "3"
+    assert rows[1]["grass"] == "28"
+
+
+def test_cli_runs_and_writes_csv(tmp_path, capsys):
+    path = tmp_path / "out.csv"
+    exit_code = main(
+        [
+            "--width", "10",
+            "--height", "10",
+            "--rabbits", "5",
+            "--foxes", "2",
+            "--steps", "5",
+            "--seed", "42",
+            "--output", str(path),
+        ]
+    )
+    assert exit_code == 0
+    assert path.exists()
+    out = capsys.readouterr().out
+    assert "Simulation complete" in out
+    assert "Steps run:        5" in out
+
+
+def test_cli_invalid_width():
+    with pytest.raises(SystemExit) as excinfo:
+        main(["--width", "-5", "--steps", "1"])
+    assert excinfo.value.code != 0
+
+
+def test_cli_invalid_steps():
+    with pytest.raises(SystemExit) as excinfo:
+        main(["--steps", "-3"])
+    assert excinfo.value.code != 0
+
+
+def test_cli_non_integer_argument():
+    with pytest.raises(SystemExit):
+        build_parser().parse_args(["--steps", "abc"])
