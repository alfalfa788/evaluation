+"""Tests for the Ecosystem class."""
+
+import pytest
+
+from simulation.animals import Fox, Grass, Rabbit
+from simulation.ecosystem import Ecosystem
+
+
+def test_ecosystem_initial_population():
+    eco = Ecosystem(width=10, height=10, num_rabbits=7, num_foxes=3, seed=42)
+    rabbits, foxes, _ = eco.counts()
+    assert rabbits == 7
+    assert foxes == 3
+
+
+def test_invalid_dimensions_raise():
+    with pytest.raises(ValueError):
+        Ecosystem(width=0, height=10)
+    with pytest.raises(ValueError):
+        Ecosystem(width=10, height=-1)
+
+
+def test_invalid_counts_raise():
+    with pytest.raises(ValueError):
+        Ecosystem(width=10, height=10, num_rabbits=-1)
+
+
+def test_negative_steps_raise():
+    eco = Ecosystem(width=5, height=5, seed=1)
+    with pytest.raises(ValueError):
+        eco.run(-1)
+
+
+def test_dead_animals_removed():
+    eco = Ecosystem(width=5, height=5, num_rabbits=0, num_foxes=0, seed=1)
+    eco.rabbits = [
+        Rabbit(position=(0, 0), energy=0),
+        Rabbit(position=(1, 1), energy=5),
+    ]
+    eco.foxes = [Fox(position=(0, 0), energy=0)]
+    eco.remove_dead()
+    assert len(eco.rabbits) == 1
+    assert eco.rabbits[0].energy == 5
+    assert len(eco.foxes) == 0
+
+
+def test_rabbit_eats_grass_in_step():
+    eco = Ecosystem(width=3, height=3, num_rabbits=0, num_foxes=0, seed=1)
+    eco.grass = {}
+    rabbit = Rabbit(position=(1, 1), energy=10)
+    eco.rabbits = [rabbit]
+    # Place grass everywhere so the rabbit lands on grass regardless of move.
+    for x in range(3):
+        for y in range(3):
+            eco.grass[(x, y)] = Grass((x, y), growth=1)
+    eco.step_rabbits()
+    # Rabbit gained eat_gain but paid move_cost.
+    assert rabbit.energy == 10 - Rabbit.move_cost + Rabbit.eat_gain
+
+
+def test_fox_hunts_rabbit_in_step():
+    eco = Ecosystem(width=1, height=1, num_rabbits=0, num_foxes=0, seed=1)
+    fox = Fox(position=(0, 0), energy=10)
+    rabbit = Rabbit(position=(0, 0), energy=5)
+    eco.foxes = [fox]
+    eco.rabbits = [rabbit]
+    eco.step_foxes()  # on a 1x1 grid the fox stays put and hunts.
+    assert rabbit.energy == 0
+    assert fox.energy == 10 - Fox.move_cost + Fox.eat_gain
+
+
+def test_seed_reproducibility():
+    eco1 = Ecosystem(width=15, height=15, num_rabbits=10, num_foxes=3, seed=99)
+    eco2 = Ecosystem(width=15, height=15, num_rabbits=10, num_foxes=3, seed=99)
+    stats1 = eco1.run(20)
+    stats2 = eco2.run(20)
+    assert stats1.records == stats2.records
+
+
+def test_different_seed_diverges():
+    eco1 = Ecosystem(width=15, height=15, num_rabbits=10, num_foxes=3, seed=1)
+    eco2 = Ecosystem(width=15, height=15, num_rabbits=10, num_foxes=3, seed=2)
+    stats1 = eco1.run(20)
+    stats2 = eco2.run(20)
+    assert stats1.records != stats2.records
+
+
+def test_run_records_each_step():
+    eco = Ecosystem(width=8, height=8, num_rabbits=5, num_foxes=2, seed=7)
+    stats = eco.run(10)
+    assert len(stats.records) == 10
+    assert stats.records[0]["step"] == 1
+    assert stats.records[-1]["step"] == 10
+
+
+def test_grass_grows():
+    eco = Ecosystem(width=4, height=4, num_rabbits=0, num_foxes=0, seed=3)
+    eco.grass = {}
+    eco.grass_growth_chance = 1.0
+    eco.grow_grass()
+    assert len(eco.grass) == 16
