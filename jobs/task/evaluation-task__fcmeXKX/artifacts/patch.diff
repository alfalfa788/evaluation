+"""Tests for the animal and grass entity classes."""
+
+import random
+
+import pytest
+
+from simulation.animals import Fox, Grass, Rabbit
+
+
+def test_animal_has_unique_id():
+    r1 = Rabbit(position=(0, 0), energy=10)
+    r2 = Rabbit(position=(0, 0), energy=10)
+    assert r1.id != r2.id
+
+
+def test_animals_lose_energy_default():
+    rabbit = Rabbit(position=(0, 0), energy=10)
+    rabbit.lose_energy()
+    assert rabbit.energy == 10 - Rabbit.move_cost
+
+
+def test_animals_lose_energy_amount():
+    fox = Fox(position=(0, 0), energy=20)
+    fox.lose_energy(5)
+    assert fox.energy == 15
+
+
+def test_animals_age_correctly():
+    rabbit = Rabbit(position=(0, 0), energy=10, age=3)
+    rabbit.grow_older()
+    assert rabbit.age == 4
+
+
+def test_is_dead_by_energy():
+    rabbit = Rabbit(position=(0, 0), energy=0)
+    assert rabbit.is_dead()
+
+
+def test_is_dead_by_age():
+    rabbit = Rabbit(position=(0, 0), energy=10, age=Rabbit.max_age)
+    assert rabbit.is_dead()
+
+
+def test_alive_animal_not_dead():
+    rabbit = Rabbit(position=(0, 0), energy=5, age=1)
+    assert not rabbit.is_dead()
+
+
+def test_rabbit_eats_grass():
+    rabbit = Rabbit(position=(1, 1), energy=5)
+    grass = Grass(position=(1, 1), growth=3)
+    gained = rabbit.eat(grass)
+    assert gained == Rabbit.eat_gain
+    assert rabbit.energy == 5 + Rabbit.eat_gain
+    assert grass.growth == 0
+
+
+def test_fox_hunts_rabbit():
+    fox = Fox(position=(2, 2), energy=10)
+    rabbit = Rabbit(position=(2, 2), energy=8)
+    gained = fox.hunt(rabbit)
+    assert gained == Fox.eat_gain
+    assert fox.energy == 10 + Fox.eat_gain
+    assert rabbit.energy == 0
+    assert rabbit.is_dead()
+
+
+def test_rabbit_reproduction_creates_valid_animal():
+    parent = Rabbit(position=(4, 5), energy=30)
+    rng = random.Random(1)
+    child = parent.reproduce(rng)
+    assert isinstance(child, Rabbit)
+    assert child.position == (4, 5)
+    assert child.energy == Rabbit.offspring_energy
+    assert child.id != parent.id
+    assert parent.energy == 30 - Rabbit.offspring_energy
+
+
+def test_fox_reproduction_creates_valid_animal():
+    parent = Fox(position=(4, 5), energy=40)
+    rng = random.Random(1)
+    child = parent.reproduce(rng)
+    assert isinstance(child, Fox)
+    assert child.energy == Fox.offspring_energy
+    assert parent.energy == 40 - Fox.offspring_energy
+
+
+def test_move_stays_on_grid():
+    rng = random.Random(0)
+    rabbit = Rabbit(position=(0, 0), energy=10)
+    for _ in range(50):
+        rabbit.move(5, 5, rng)
+        x, y = rabbit.position
+        assert 0 <= x < 5
+        assert 0 <= y < 5
+
+
+def test_grass_grow_capped():
+    grass = Grass(position=(0, 0), growth=4)
+    grass.grow(amount=10, maximum=5)
+    assert grass.growth == 5
